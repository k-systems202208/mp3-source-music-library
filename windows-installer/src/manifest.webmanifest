{
  "id": "/music-library",
  "name": "自宅音楽ライブラリ",
  "short_name": "音楽ライブラリ",
  "description": "自宅PCの音楽ライブラリを、Tailscale経由でスマートフォンから検索・再生します。",
  "lang": "ja",
  "start_url": "./music-library-search.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#efe8d8",
  "theme_color": "#24392b",
  "categories": ["music", "entertainment"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./pwa-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./pwa-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./pwa-icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
